{
  "name": "leafline",
  "productName": "Leafline",
  "version": "0.1.0",
  "description": "Leafline \u2014 a fast, beautiful, open-source PDF viewer and editor that runs entirely in your browser.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GreatOSS/pdf-fable.git"
  },
  "scripts": {
    "assets": "node scripts/copy-pdfjs-assets.mjs",
    "samples": "node scripts/make-samples.mjs",
    "predev": "npm run assets && npm run samples",
    "dev": "vite",
    "prebuild": "npm run assets && npm run samples",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && vite build",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "patch-package": "^8.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
